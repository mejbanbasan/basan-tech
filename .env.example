# Primary Gemini API Key
GEMINI_API_KEY=""

# Multi-Key Failover (GEMINI_API_KEY_1 through GEMINI_API_KEY_10)
# If Key 1 exhausts its 5-model cascade (or rate limits/quota), the engine seamlessly retries Key 2... up to Key 10.
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""
GEMINI_API_KEY_5=""
GEMINI_API_KEY_6=""
GEMINI_API_KEY_7=""
GEMINI_API_KEY_8=""
GEMINI_API_KEY_9=""
GEMINI_API_KEY_10=""

# Optional: Override the 5 fallback models in order (comma-separated)
# Defaults to: gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash,gemini-2.5-pro,gemini-1.5-pro
# GEMINI_MODELS="gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash,gemini-2.5-pro,gemini-1.5-pro"

# APP_URL: The URL where the site is hosted
APP_URL="https://basantech.online"
